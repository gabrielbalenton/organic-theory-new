{
  "headers": [
    {
      "source": "/internal",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/vault",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/randall-penn-preview",
      "destination": "/randall-penn/option-2",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/randall-penn/option-1",
      "destination": "/randall-penn/option-1.html"
    },
    {
      "source": "/randall-penn/option-2",
      "destination": "/randall-penn/option-2.html"
    },
    {
      "source": "/randall-penn/option-3",
      "destination": "/randall-penn/option-3.html"
    },
    {
      "source": "/randall-penn/homepage",
      "destination": "/randall-penn/homepage.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
